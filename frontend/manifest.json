{
  "manifest_version": 3,
  "name": "Clipzy: YouTube로 이중자막 번역 & AI 영어 학습",
  "version": "1.0.15",
  "description": "유튜브 이중자막 번역과 AI 영어 학습을 한 번에!",
  "action": {
    "default_title": "CLIPZY 열기"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions":[
    "sidePanel",
    "storage",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://clip-server.com/*",
    "https://dev.clip-server.com/*"
  ],
  "content_scripts":[
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js":["src/content.jsx"]
    }
  ]
}